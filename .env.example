# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Whisper para transcrição: tiny, base, small, medium, large-v3
# "base" é muito rápido e ideal para testes. "small" ou "medium" traz mais fidelidade em português.
WHISPER_MODEL=base

# Quantidade padrão de cortes virais a gerar por vídeo
MAX_CLIPS=3

# Duração mínima e máxima dos cortes (em segundos)
MIN_CLIP_DURATION=30
MAX_CLIP_DURATION=60
